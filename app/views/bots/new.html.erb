      <div class="container mt-4">
  <h1 class="text-center mb-4">Tạo Bot mới</h1>
  <% if flash[:notice] %>
          <div class="alert alert-success">
            <%= flash[:notice] %>
          </div>
        <% end %>

         <% if flash[:alert] %>
          <div class="alert alert-success">
            <%= flash[:alert] %>
          </div>
        <% end %>
  <div class="card">
    <div class="card-body">
      <%= form_with(model: @bot, local: true, html: { class: "needs-validation" }) do |f| %>
        <div class="form-group">
          <%= f.label :name, "Tên bot", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true, placeholder: "Nhập tên bot..." %>
        </div>

        <div class="form-group">
          <%= f.label :bot_identifier, "Mã web", class: "form-label" %>
          <%= f.text_field :bot_identifier, class: "form-control", required: true, placeholder: "Nhập mã website..." %>
        </div>

        <%= link_to 'Quay lại danh sách bot', bots_path, class: "btn btn-secondary ml-2", data: { turbo: false }%>
        <%= f.submit "Tạo Bot", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>