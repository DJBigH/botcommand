    <div class="container mt-2">
      <h1 class="text-center">Danh sách Bot</h1>
      <div class="text-right mb-3">
        <%= link_to 'Danh sách trò chuyện', admin_chatsessions_path, class: 'btn btn-info' %>
      </div>

        <% if flash[:notice] %>
          <div class="alert alert-success">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <% if flash[:error] %>
          <div class="alert alert-danger">
            <%= flash[:error] %>
          </div>
        <% end %>


        <% if flash[:alert] %>
          <div class="alert alert-success">
            <%= flash[:alert] %>
          </div>
        <% end %>
      <%= link_to 'Tạo bot mới', new_bot_path, class: 'btn btn-primary mb-2 float-right' %>
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>ID</th>
            <th>Ten Bot</th>
            <th>Thoi gian tao</th>
            <th>Trạng thái</th>
            <th>Mã web</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if @bots.any? %>
            <% @bots.each do |item| %>
              <tr>
                <td><%= item.id%></td>
                <td><%= link_to item.name, bot_path(item)%></td>
                <td><%= item.created_at.strftime("%d-%m-%Y") %></td>
                <td>
                  <% case item.status %>
                  <% when "not_started" %>
                    <span class="badge badge-secondary">Chưa khởi động...</span>
                  <% when "starting" %>
                    <span class="badge badge-warning">Đang khởi động...</span>
                  <% when "running" %>
                    <span class="badge badge-success">Đã khởi động...</span>
                  <% when "training" %>
                    <span class="badge badge-warning">Đang train bot...</span>
                  <% when "error" %>
                    <span class="badge badge-danger">Bot lỗi...</span>
                  <% else %>
                    <span class="badge badge-dark">Không xác định</span>
                  <% end %>
                </td>
                <td><%= item.bot_identifier%></td>
                <td>
                  <%= link_to 'Trò chuyện với bot', bot_chat_ui_path(item), class: 'btn btn-success mt-2', data: { turbo: false } %>
                  <% if item.status == 'running' %>
                    <%= button_to 'Stop', stop_bot_path(item), method: :post, class: 'btn btn-danger mt-2',
                  data: { confirm: "Bạn chắc chắn muốn dừng bot '#{item.name}' chứ?" } %>
                  <% else %>
                    <%= button_to 'Start', run_bot_path(item), method: :get, class: 'btn btn-warning mt-2' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center text-muted">Chưa có dữ liệu bot nào</td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="d-flex justify-content-end">
        <%= will_paginate @bots, class: 'pagination justify-content-end' %>
      </div>
    </div>