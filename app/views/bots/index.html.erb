<!doctype html>
<html lang="en">
  <head>
    <title>Title</title>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
  </head>
  <body>
      <div class="container mt-2">
      <h1 class="text-center">Danh sách Bot</h1>
        <% if flash[:notice] %>
          <div class="alert alert-success">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <% if flash[:error] %>
          <div class="alert alert-danger">
            <%= flash[:error] %>
          </div>
        <% end %>


        <% if flash[:alert] %>
          <div class="alert alert-success">
            <%= flash[:alert] %>
          </div>
        <% end %>
      <%= link_to 'Tạo bot mới', new_bot_path, class: 'btn btn-primary mb-2 float-right' %>
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>ID</th>
            <th>Ten Bot</th>
            <th>Thoi gian tao</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if @bots.any? %>
          <% @bots.each do |item| %>
        <tr>
        <td><%= item.id%></td>
        <td><%= link_to item.name, bot_path(item)%></td>
        <td><%= item.created_at.strftime("%d-%m-%Y") %></td>

        <td>
          <% case item.status %>
          <% when "not_started" %>
            <span class="badge badge-secondary">Chưa khởi động...</span>
          <% when "starting" %>
            <span class="badge badge-warning">Đang khởi động...</span>
          <% when "running" %>
            <span class="badge badge-success">Đã khởi động...</span>
          <% when "training" %>
            <span class="badge badge-warning">Đang train bot...</span>
          <% when "error" %>
            <span class="badge badge-danger">Bot lỗi...</span>
          <% else %>
            <span class="badge badge-dark">Không xác định</span>
          <% end %>
        </td>

        <td>
          <%= link_to 'Trò chuyện với bot', bot_chat_ui_path(item), class: 'btn btn-success mt-2', data: { turbo: false } %>

          <% if item.status == 'running' %>
            <%= button_to 'Stop', stop_bot_path(item), method: :post, class: 'btn btn-danger mt-2',
                  data: { confirm: "Bạn chắc chắn muốn dừng bot '#{item.name}' chứ?" } %>
          <% else %>
            <%= button_to 'Start', run_bot_path(item), method: :get, class: 'btn btn-warning mt-2' %>
          <% end %>
        </td>

      </tr>
    <% end %>
  <% else %>
    <tr>
      <td colspan="5" class="text-center text-muted">Chưa có dữ liệu bot nào</td>
    </tr>
  <% end %>
  </tbody>


      </table>
      </div>
    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
  </body>
</html>