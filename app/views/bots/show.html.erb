<div class="container mt-4">
  <h1 class="text-center">Bot: <%= @bot.name %></h1>
  <% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %> <% if flash[:alert] %>
  <div class="alert alert-success"><%= flash[:alert] %></div>
  <% end %>

  <!-- Import Excel -->
  <div class="card mt-4 border-success">
    <div class="card-header bg-success text-white">
      <h4 class="mb-0">
        <i class="fas fa-file-excel"></i> Import Prompt từ Excel
      </h4>
    </div>

    <div class="card-body">
      <%= form_with url: import_excel_bot_path(@bot), local: true, multipart: true do |f| %>

      <div class="form-group">
        <label for="excel_file">
          Chọn file Excel <small class="text-muted">(.xlsx)</small>
        </label>
        <div class="custom-file">
          <%= f.file_field :file, class: "custom-file-input", id: "excel_file",
          accept: ".xlsx", required: true %>
          <label class="custom-file-label" for="excel_file">
            Chưa chọn file
          </label>
        </div>
      </div>

      <div class="alert alert-info">
        <strong>Lưu ý:</strong>
        <ul class="mb-0">
          <li>
            File phải có cột <code>question</code>, <code>answer</code>,
            <code>category</code>
          </li>
          <li>Không cần <code>bot_id</code></li>
          <li>Hàng đầu là header</li>
        </ul>
      </div>

      <div class="text-right">
        <%= f.submit "Import Excel", class: "btn btn-success" %>
      </div>
      <% end %>
    </div>
  </div>

  <!-- Form thêm prompt -->
  <div class="card mt-4">
    <div class="card-header">
      <h4>Thêm Prompt (Câu hỏi - Câu trả lời)</h4>
    </div>
    <div class="card-body">
      <%= form_with model: @prompt, url: add_prompt_bot_path(@bot), local: true do |f| %>
      <div class="form-group">
        <%= f.label :question, "Câu hỏi" %> <%= f.text_area :question, class:
        "form-control", rows: 3 %>
      </div>

      <div class="form-group">
        <%= f.label :answer, "Câu trả lời" %> <%= f.text_area :answer, class:
        "form-control", rows: 7 %>
      </div>

      <!-- <div class="form-group">
          <%= f.label :category, "Danh mục" %>
          <%= select_tag :category, options_for_select(PromptCategory.pluck(:name) + ['Khác']), include_blank: "Chọn danh mục", class: "form-control", id: "category_select" %>
        </div> -->

      <div class="form-group" id="custom_category_input" style="display: none">
        <%= label_tag :custom_category, "Nhập danh mục mới:" %> <%=
        text_field_tag :custom_category, nil, class: "form-control" %>
      </div>

      <%= f.submit "Thêm Prompt", class: "btn btn-primary float-right" %> <% end
      %>
    </div>
  </div>

  <!-- Danh sách prompt -->
  <div class="mt-5">
    <h4>Danh sách Prompt</h4>
    <% if @prompts.any? %>
    <div class="border rounded" style="max-height: 300px; overflow-y: auto">
      <ul class="list-group list-group-flush">
        <% @prompts.each do |p| %>
        <li class="list-group-item">
          <strong>STT: </strong> <%= p.id %><br />
          <strong>Q:</strong> <%= p.question %><br />
          <strong>A:</strong> <%= p.answer %>
        </li>
        <% end %>
      </ul>
    </div>
    <% else %>
    <p class="text-muted">Chưa có prompt nào được thêm.</p>
    <% end %>
  </div>

  <!-- Button Train + Quay lại -->
  <div class="mt-4 d-flex float-right">
    <%= link_to 'Quay lại danh sách bot', bots_path, class: "btn btn-secondary"
    %> <%= button_to "Train Bot", train_bot_path(@bot), method: :post, class:
    "btn btn-success ml-2" %>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const categorySelect = document.getElementById("category_select");
    const customInput = document.getElementById("custom_category_input");

    if (!categorySelect) return;

    categorySelect.addEventListener("change", function () {
      if (this.value === "Khác") {
        customInput.style.display = "block";
      } else {
        customInput.style.display = "none";
      }
    });

    const fileInput = document.querySelector(".custom-file-input");

    if (fileInput) {
      fileInput.addEventListener("change", function (e) {
        const fileName = e.target.files[0]?.name || "Chưa chọn file";
        e.target.nextElementSibling.innerText = fileName;
      });
    }
  });
</script>
