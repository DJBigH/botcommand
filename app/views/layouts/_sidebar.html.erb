<aside class="main-sidebar sidebar-dark-primary elevation-4">
  <!-- Brand Logo -->
  <%= link_to root_path, class: "brand-link" do %>
      <img src="/dist/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
      <span class="brand-text font-weight-light">AdminLTE 3</span>   
  <% end %>

  <!-- Sidebar -->
  <div class="sidebar">
    <!-- Sidebar user panel -->
    <div class="user-panel mt-3 pb-3 mb-3 d-flex">
      <div class="image">
        <img src="/dist/img/user2-160x160.jpg" alt="" class="img-circle elevation-2">
      </div>
      <div class="info">
        <a href="#" class="d-block">A Đờ Min</a>
      </div>
    </div>

    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

        <li class="nav-item">
          <%= link_to root_path, class: "nav-link #{current_page?(root_path) ? 'active' : ''}" do %>
            <i class="nav-icon fas fa-tachometer-alt"></i>
            <p>Tổng quan</p>
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to bots_path, class: "nav-link #{current_page?(bots_path) ? 'active' : ''}" do %>
            <i class="nav-icon fas fa-robot"></i>
            <p>Danh sách Bots</p>
          <% end %>
        </li>

        <li class="nav-item">
          <%= link_to new_bot_path, class: "nav-link #{current_page?(new_bot_path) ? 'active' : ''}" do %>
            <i class="nav-icon fas fa-plus-circle"></i>
            <p>Tạo Bot mới</p>
          <% end %>
        </li>

      </ul>
    </nav>
  </div>
</aside>
