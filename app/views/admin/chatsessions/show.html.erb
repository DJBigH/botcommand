<h3>
  Chat với: <%= @chat_session.name || 'Khách' %> 
  | Bot: <%= @chat_session.bot.name %>
</h3>

<style>
  #chat-box {
    height: 400px;
    overflow-y: auto;
    border: 1px solid #ccc;
    padding: 12px;
    background: #f9f9f9;
    border-radius: 8px;
    box-shadow: inset 0 0 5px rgba(0,0,0,0.05);
  }
  .chat-message {
    margin: 6px 0;
    padding: 10px 14px;
    border-radius: 16px;
    max-width: 70%;
    clear: both;
    position: relative;
    word-wrap: break-word;
  }
  .user-message {
    background-color: #d4edda;
    color: #155724;
    float: left;
    text-align: left;
  }
  .admin-message {
    background-color: #f8d7da;
    color: #721c24;
    float: right;
    text-align: right;
  }
  .timestamp {
    font-size: 0.75rem;
    color: #888;
    margin-top: 2px;
    display: block;
  }
</style>

<div id="chat-box">
  <% @chat_messages.each do |msg| %>
    <div class="chat-message <%= msg.sender == 'admin' ? 'admin-message' : 'user-message' %>">
      <strong><%= msg.sender.capitalize %>:</strong> <%= msg.content %>
      <span class="timestamp"><%= msg.created_at.strftime("%H:%M") %></span>
    </div>
  <% end %>
</div>

<form id="chat-form" class="mt-3">
  <div class="input-group">
    <input type="text" id="message-input" class="form-control" placeholder="Nhập tin nhắn..." autocomplete="off" />
    <div class="input-group-append">
      <button type="submit" class="btn btn-success">Gửi</button>
    </div>
  </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/actioncable@5.2.8-1/lib/assets/compiled/action_cable.min.js"></script>
<script>
document.addEventListener("turbo:load", function() {
  (function() {
    window.isAdmin = true;
    const chatBox = document.getElementById("chat-box");
    const chatId = "<%= @chat_session.id %>";

    // Kết nối WebSocket
    const cable = ActionCable.createConsumer("ws://localhost:3000/cable");

    const channel = cable.subscriptions.create(
      { channel: "ChatChannel", chat_id: chatId },
      {
        received(data) {
          if (data.type === 'admin_joined_notice') {
            appendMessage("Admin đã tham gia chat", "system");
            return;
          }
          appendMessage(data.message, data.sender, data.timestamp);
        }
      }
    );

    document.getElementById("chat-form").addEventListener("submit", function (e) {
      e.preventDefault();
      const input = document.getElementById("message-input");
      const content = input.value.trim();
      if (!content) return;

      channel.send({
        sender: 'admin',
        message: content
      });

      input.value = '';
    });

    function appendMessage(message, sender, timestamp) {
      const msg = document.createElement("div");
      msg.className = "chat-message " + 
        (sender === 'admin' ? 'admin-message' : sender === 'system' ? 'system-message' : 'user-message');
      msg.innerHTML = `<strong>${sender}:</strong> ${message}
        <span class="timestamp">${timestamp || new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>`;
      chatBox.appendChild(msg);
      chatBox.scrollTo({ top: chatBox.scrollHeight, behavior: 'smooth' });
    }
  })();
});
</script>
