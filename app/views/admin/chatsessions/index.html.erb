<!doctype html>
<html lang="en">
  <head>
    <title>Title</title>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
  </head>
  <body>
      <div class="container mt-3">
        <!-- app/views/admin/chat_sessions/index.html.erb -->
<h2 class="text-center">Danh sách các cuộc trò chuyện</h2>
    <%= link_to "Trở về", bots_path, class: 'btn btn-primary mb-2'%>

<table class="table table-bordered text-center">
  <thead>
    <tr>
      <th>Người dùng</th>
      <th>SĐT</th>
      <th>Bot</th>
      <th>Trạng thái</th>
      <th>Hành động</th>
    </tr>
  </thead>
  <tbody>
    <% @chat_sessions.each do |session| %>
      <tr>
        <td><%= session.name || "Khách" %></td>
        <td><%= session.phone %></td>
        <td><%= session.bot.name %></td>
        <td>
          <% if session.active %>
            <span class="badge badge-success">Đang hoạt động</span>
          <% else %>
            <span class="badge badge-secondary">Kết thúc</span>
          <% end %>
          <% if session.admin_joined %>
            <span class="badge badge-info">Admin đã tham gia</span>
          <% end %>
        </td>
        <td>
          <%= link_to 'Tham gia', admin_chatsession_path(session), class: 'btn btn-sm btn-primary' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

      </div>
    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
  </body>
</html>